string target_id
geometry_msgs/Pose2D target_pose
# 레인 폴리라인. 첫 점은 로봇이 있는 곳, 끝 점은 target_pose. 비면 target_pose로 간다
geometry_msgs/Pose[] path
---
string REASON_NAV_ABORTED="NAV_ABORTED"
string REASON_CANCELED="CANCELED"
string REASON_TIMEOUT="TIMEOUT"
string REASON_HEARTBEAT_LOST="HEARTBEAT_LOST"
# 제안(팀 합의 전): path가 로봇의 지금 위치를 지나지 않아 따라가지 않았다(R20)
string REASON_PATH_NOT_CONNECTED="PATH_NOT_CONNECTED"

bool success
string reason
---
float32 distance_remaining
